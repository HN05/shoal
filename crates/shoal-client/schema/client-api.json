            "$ref": "#/$defs/ReadyMark"
          },
          "type": "array"
        },
        "repository_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/WorkspaceState"
        },
        "title": {
          "description": "What its agent calls the work.",
          "type": [
            "string",
            "null"
          ]
