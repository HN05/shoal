{
  "$defs": {
    "AcquireHold": {
      "properties": {
        "name": {
          "type": "string"
        },
        "reason": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "name"
      ],
      "type": "object"
    },
    "AcquireSimulator": {
      "properties": {
        "device": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "description": "The lease's name; `default` when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "default": null,
          "description": "A configured simulator profile.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "default": null,
          "description": "Why the lease is needed, which a lease that needs approval asks for.",
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "AddLink": {
      "properties": {
        "item": {
          "description": "The item's number in the workspace's repository, or its URL.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "kind",
        "item",
        "relation"
      ],
      "type": "object"
    },
    "AgentState": {
      "anyOf": [
        {
          "enum": [
            "working",
            "waiting",
            "idle",
            "running",
            "queued",
            "starting",
            "stopped"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "AgentStatus": {
      "description": "A workspace's agent and its state.",
      "properties": {
        "agent": {
          "description": "The agent's name, such as `claude`, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "description": "Unix seconds since the state was reported, when known.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "AnswerQuestion": {
      "properties": {
        "answer": {
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "shown": {
          "anyOf": [
            {
              "$ref": "#/$defs/Question"
            },
            {
              "type": "null"
            }
          ],
          "description": "The question as shown. When given, a question that no longer matches\nit, such as a later one reusing its number, is refused with `not_found`."
        }
      },
      "required": [
        "id",
        "answer"
      ],
      "type": "object"
    },
    "ApiError": {
      "description": "A refusal from the daemon.",
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "description": "The approval request of an `approval_pending` or `approval_denied` refusal."
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Approval": {
      "description": "A workspace's request for the user's approval.",
      "properties": {
        "created_at": {
          "description": "Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "The number it is decided by; reused once the request is gone.",
          "format": "int64",
          "type": "integer"
        },
        "key": {
          "description": "What names this request for good, unlike its number.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "target": {
          "description": "What it authorizes, such as `simulator`, `port/web` or `pr_open`.",
          "type": "string"
        },
        "workspace": {
          "description": "The workspace's name.",
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "workspace_id",
        "workspace",
        "target",
        "name",
        "reason",
        "status",
        "created_at"
      ],
      "type": "object"
    },
    "ApprovalStatus": {
      "anyOf": [
        {
          "enum": [
            "pending",
            "approved",
            "denied",
            "outdated",
            "withdrawn"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Check": {
      "description": "One CI check of a PR.",
      "properties": {
        "complete": {
          "description": "Whether the check finished.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "description": "The forge's state, such as `success`, `failure` or `pending`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state",
        "complete"
      ],
      "type": "object"
    },
    "Completion": {
      "properties": {
        "cleanup": {
          "description": "Whether the workspace is removed once it qualifies.",
          "type": "boolean"
        },
        "head": {
          "description": "The commit the completion covers.",
          "type": "string"
        }
      },
      "required": [
        "head",
        "cleanup"
      ],
      "type": "object"
    },
    "DecideApproval": {
      "properties": {
        "approve": {
          "type": "boolean"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "shown": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "description": "The request as shown. When given, a request that no longer matches\nit, such as a later one reusing its number, is refused with `not_found`."
        }
      },
      "required": [
        "id",
        "approve"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "anyOf": [
        {
          "enum": [
            "invalid_request",
            "unsupported_version",
            "not_found",
            "name_taken",
            "scope_denied",
            "approval_pending",
            "approval_denied",
            "busy",
            "not_ready",
            "unsaved_work",
            "operation_failed"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Event": {
      "description": "What a subscription sends: its snapshot in one or more parts, then each\nchange. After a daemon restart the connection closes; a new subscription\nstarts with a new snapshot.",
      "oneOf": [
        {
          "description": "Some of the records the subscription covers, as they are now;\n`complete` marks the last part.",
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/Record"
              },
              "type": "array"
            },
            "type": {
              "const": "snapshot",
              "type": "string"
            }
          },
          "required": [
            "type",
            "records",
            "complete"
          ],
          "type": "object"
        },
        {
          "description": "A record was added or changed, and is now `record`.",
          "properties": {
            "record": {
              "$ref": "#/$defs/Record"
            },
            "type": {
              "const": "changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "record"
          ],
          "type": "object"
        },
        {
          "description": "The record `key` names was removed.",
          "properties": {
            "key": {
              "$ref": "#/$defs/RecordKey"
            },
            "type": {
              "const": "removed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "key"
          ],
          "type": "object"
        },
        {
          "description": "An event this version does not know; ignore it.",
          "properties": {
            "type": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "GetWorkspace": {
      "properties": {
        "workspace": {
          "description": "The workspace's ID or name.",
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "HandshakeReply": {
      "description": "The daemon's answer to [`Opening`].",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "welcome": {
              "$ref": "#/$defs/Welcome"
            }
          },
          "required": [
            "welcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The daemon refused the connection, such as with `unsupported_version`.",
          "properties": {
            "error": {
              "$ref": "#/$defs/ApiError"
            }
          },
          "required": [
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "Hello": {
      "properties": {
        "client": {
          "description": "The client's name, for the daemon's log.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "description": "A workspace's scope token; without one the caller is the user.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "The API version the client speaks, such as `1.0.0`.",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "Hold": {
      "description": "A named claim that a workspace is still in use.",
      "properties": {
        "created_at": {
          "description": "Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "created_at"
      ],
      "type": "object"
    },
    "Item": {
      "description": "An issue or PR.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "type": "object"
    },
    "ItemKind": {
      "anyOf": [
        {
          "enum": [
            "issue",
            "pr",
            "ci"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Link": {
      "description": "An issue or PR a workspace links, with its state as the daemon last\nrecorded it from the forge.",
      "properties": {
        "checks": {
          "description": "A PR's CI checks on its head.",
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        "conflict": {
          "description": "Whether a PR conflicts with its base; absent when unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "head": {
          "description": "A PR's head commit, which its checks ran on.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "state": {
          "description": "The forge's state, such as `open`, `closed` or `merged`; absent until\nthe daemon has looked.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "kind",
        "url",
        "relation",
        "checks"
      ],
      "type": "object"
    },
    "ListRepositories": {
      "type": "object"
    },
    "MarkDone": {
      "properties": {
        "cleanup": {
          "default": false,
          "description": "Remove the workspace once it qualifies, even where `[done] cleanup` is false.",
          "type": "boolean"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "Message": {
      "description": "A message to a workspace's agent or from one to the user.",
      "properties": {
        "attachments": {
          "description": "Shoal's copies of the attached files.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "description": "Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "recipient": {
          "$ref": "#/$defs/MessageRecipient"
        },
        "text": {
          "description": "Empty when the message is only its attachments.",
          "type": "string"
        },
        "workspace": {
          "description": "The workspace's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "description": "The workspace's ID, for a message to its agent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "recipient",
        "text",
        "attachments",
        "created_at"
      ],
      "type": "object"
    },
    "MessageRecipient": {
      "anyOf": [
        {
          "enum": [
            "agent",
            "user"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Notification": {
      "description": "Something the daemon tells the user.",
      "properties": {
        "created_at": {
          "description": "Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "description": "What happened, such as `question_asked` or `workspace_removed`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "read": {
          "type": "boolean"
        },
        "workspace": {
          "description": "The workspace's name when it happened.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "message",
        "read",
        "created_at"
      ],
      "type": "object"
    },
    "Opening": {
      "description": "The client's first frame. Its `client_api` key tells the daemon the\nconnection speaks this API rather than Shoal's internal protocol.",
      "properties": {
        "client_api": {
          "$ref": "#/$defs/Hello"
        }
      },
      "required": [
        "client_api"
      ],
      "type": "object"
    },
    "Question": {
      "description": "An open question a workspace's agent asked the user.",
      "properties": {
        "choices": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "description": "Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "description": "The number it is answered by; reused once the question is gone.",
          "format": "int64",
          "type": "integer"
        },
        "question": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommendation": {
          "type": "string"
        },
        "workspace": {
          "description": "The workspace's name.",
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "workspace",
        "question",
        "recommendation",
        "choices",
        "created_at"
      ],
      "type": "object"
    },
    "QueueAgent": {
      "properties": {
        "agent": {
          "description": "The agent to start, such as `claude` or `codex`.",
          "type": "string"
        },
        "prompt": {
          "default": null,
          "description": "The agent's first message; without one it waits for the user.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "agent"
      ],
      "type": "object"
    },
    "QueueState": {
      "anyOf": [
        {
          "enum": [
            "queued",
            "starting"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "QueuedAgent": {
      "properties": {
        "id": {
          "description": "The queue entry's ID.",
          "type": "string"
        },
        "position": {
          "description": "Its place among waiting entries, from 1; absent once starting.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/QueueState"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "type": "object"
    },
    "ReadyMark": {
      "description": "A statement that linked work is ready for review at a commit.",
      "properties": {
        "created_at": {
          "description": "Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "head": {
          "description": "The commit the mark covers.",
          "type": "string"
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/Item"
            },
            {
              "type": "null"
            }
          ],
          "description": "The marked issue or PR; absent when the mark covers the workspace."
        }
      },
      "required": [
        "head",
        "created_at"
      ],
      "type": "object"
    },
    "Record": {
      "description": "One record, tagged with its kind as `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Repository",
          "properties": {
            "type": {
              "const": "repository",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Workspace",
          "properties": {
            "type": {
              "const": "workspace",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Link",
          "properties": {
            "type": {
              "const": "link",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Question",
          "properties": {
            "type": {
              "const": "question",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Approval",
          "properties": {
            "type": {
              "const": "approval",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Message",
          "properties": {
            "type": {
              "const": "message",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Notification",
          "properties": {
            "type": {
              "const": "notification",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A kind this version does not know; ignore it.",
          "properties": {
            "type": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "RecordKey": {
      "description": "What names a record among those of its kind. The ID is opaque: compare\nit, never parse it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RecordKind"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "RecordKind": {
      "anyOf": [
        {
          "enum": [
            "repository",
            "workspace",
            "link",
            "question",
            "approval",
            "message",
            "notification"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Relation": {
      "anyOf": [
        {
          "enum": [
            "assigned",
            "opened",
            "related"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ReleaseHold": {
      "properties": {
        "name": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "name"
      ],
      "type": "object"
    },
    "ReleaseSimulator": {
      "properties": {
        "name": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "name"
      ],
      "type": "object"
    },
    "Removal": {
      "properties": {
        "branch": {
          "description": "The workspace's branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "branch_deleted": {
          "description": "Whether the branch was deleted; it is kept when only it has some commits.",
          "type": "boolean"
        },
        "hook_error": {
          "description": "Why the best-effort removal hook failed, after a removal that succeeded.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "branch_deleted"
      ],
      "type": "object"
    },
    "RemoveLink": {
      "properties": {
        "item": {
          "description": "The item's number in the workspace's repository, or its URL.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
