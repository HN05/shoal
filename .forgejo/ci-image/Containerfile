# CI image for the Forgejo workflows on the Docker runner; ci.yml's rust checks
# run on Shoal runners instead. Everything the jobs would otherwise
# install per run lives here, and the tag is the Rust version: never a
# floating tag, so a run can say which toolchain it used. The tools the tests
# spawn are also what a Shoal runner's machine needs.
#
# Build with ./build.sh on the runner host, then bump ARG RUST below and the
# `image:` tags in every workflow that uses this image, and package.rust-version
# in Cargo.toml. A change here that keeps
# the Rust version still needs a rebuild with the same tag. See AGENTS.md "CI".
#
# Jobs on the Docker runner use no JavaScript actions (actions/checkout,
# actions/cache): the runner would have to inject Node into the job container,
# which does not work under Podman. Hence their plain-git checkout, and caching
# by the runner rather than the workflow; its config mounts host directories
# into every job container:
#   /var/cache/ci/cargo/registry -> /usr/local/cargo/registry
#   /var/cache/ci/cargo/git      -> /usr/local/cargo/git
#   /var/cache/ci/target         -> /ci-target
# Every step that runs cargo in /ci-target first sources
# .forgejo/scripts/lock-target-dir.sh, which moves CARGO_TARGET_DIR to a free
# slot directory under it and holds that slot for the rest of the step, and runs
# `cargo clean --workspace` before its first build so another branch's build of
# the workspace's packages is never taken as fresh. ci.yml's musl job instead
# touches its tracked files once it holds the slot, which makes them newer than
# any build there and keeps the dependencies' builds warm. The directories grow
# without bound; clear /var/cache/ci/target on the runner host when it gets
# large.

ARG RUST=1.99
FROM docker.io/library/rust:${RUST}-trixie

# The daemon and workspace tests spawn these: git and Worktrunk for worktrees,
# lsof for port checks, zsh and bash as user shells, python3 for the xcrun
# fixture and the release scripts, tmux for the tmux host's tests against an
# isolated server. curl and jq serve ci.yml's undraft and gate jobs,
# deps.yml and the Zig download below; xz-utils unpacks it. pkg-config and
# libssl-dev build cargo-outdated, which links the cargo crate. tini reaps
# orphans as the job container's first process (see below).
RUN rustup component add rustfmt clippy \
 && apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      git \
      ca-certificates \
      lsof \
      zsh \
      python3 \
      tmux \
      curl \
      jq \
      xz-utils \
      pkg-config \
      libssl-dev \
      tini \
 && rm -rf /var/lib/apt/lists/*

# The runner starts every job container with `tail -f /dev/null` as PID 1,
# which never reaps: each process a test detaches would stay a zombie once it
# exits, thousands by the end of `cargo test`, and every process inventory the
# tests' daemons and fixtures take would read them all. The workflow's
# `container.options: --init` is ignored. The runner finds `tail` on this
# image's PATH, where this one comes before /usr/bin and runs tail under tini
# when it is PID 1.
COPY --chmod=755 .forgejo/ci-image/tail /usr/local/bin/tail

# Zellij serves the Zellij host's tests against isolated sessions. Debian does
# not package it, so the static release binary for this host's architecture is
# pinned, as the host's oldest supported version, and verified against the
# checksum the release publishes for it.
ARG ZELLIJ=0.45.1
RUN set -eu \
 && base="https://github.com/zellij-org/zellij/releases/download/v$ZELLIJ/zellij-$(uname -m)-unknown-linux-musl" \
 && curl -fsSL "$base.tar.gz" -o /tmp/zellij.tar.gz \
 && sum="$(curl -fsSL "$base.sha256sum" | cut -d ' ' -f 1)" \
 && tar -xzf /tmp/zellij.tar.gz -C /usr/local/bin zellij \
 && echo "$sum  /usr/local/bin/zellij" | sha256sum -c - \
 && rm -f /tmp/zellij.tar.gz

# Worktrunk is pinned because Shoal drives its CLI. --locked builds it against
# its own lockfile, so an upstream release cannot break this image. Every layer
# drops the registry it downloaded: layers are additive, so sources left here
# would survive a later RUN that deletes them, and the runner mounts the host's
# registry over that path at run time anyway.
RUN cargo install --locked worktrunk --version 0.81.0 \
 && rm -rf "$CARGO_HOME/registry"

# cargo-audit and cargo-outdated feed deps.yml's weekly report, which parses
# their JSON, so they are pinned as well. cargo-outdated builds in its own
# layer with LTO off: it links the whole cargo crate, and its final LTO pass can
# outgrow the runner LXC's memory. The slower binary does not matter weekly.
RUN cargo install --locked cargo-audit --version 0.22.2 \
 && rm -rf "$CARGO_HOME/registry"
RUN CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
    cargo install --locked cargo-outdated --version 0.19.0 \
 && rm -rf "$CARGO_HOME/registry"

# release.yml cross-builds the release binaries with cargo-zigbuild, and
# ci.yml's musl job checks the musl build with it. It links every target
# through Zig: static musl for Linux and, because Shoal links only libSystem
# and no Apple frameworks, macOS without an Apple SDK.
# The tarball is picked for this host's architecture from Zig's release index
# and verified against the checksum published there.
ARG ZIG=0.17.1
RUN set -eu \
 && arch="$(uname -m)" \
 && curl -fsSL https://ziglang.org/download/index.json -o /tmp/zig-index.json \
 && url="$(jq -er --arg v "$ZIG" --arg a "$arch-linux" '.[$v][$a].tarball' /tmp/zig-index.json)" \
 && sum="$(jq -er --arg v "$ZIG" --arg a "$arch-linux" '.[$v][$a].shasum' /tmp/zig-index.json)" \
 && curl -fsSL "$url" -o /tmp/zig.tar.xz \
 && echo "$sum  /tmp/zig.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/zig \
 && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 \
 && ln -s /opt/zig/zig /usr/local/bin/zig \
 && rm -f /tmp/zig.tar.xz /tmp/zig-index.json
COPY .forgejo/scripts/release-targets.txt /tmp/release-targets.txt
RUN rustup target add $(cut -d ' ' -f 1 /tmp/release-targets.txt) \
 && rm /tmp/release-targets.txt \
 && cargo install --locked cargo-zigbuild --version 0.24.1 \
 && rm -rf "$CARGO_HOME/registry"

# release.yml signs the macOS release binaries with rcodesign, which needs no
# Apple tools. It is pinned because sign-macos.sh parses its output.
RUN cargo install --locked apple-codesign --version 0.29.0 \
 && rm -rf "$CARGO_HOME/registry"

# Sanity: the versions the jobs will run with, visible in `podman build` output.
RUN rustc --version && cargo clippy --version && cargo fmt --version \
 && wt --version && git --version && lsof -v 2>&1 | head -1 && zsh --version && python3 --version && jq --version \
 && tmux -V && zellij --version \
 && zig version && cargo-zigbuild --version && rcodesign --version \
 && cargo audit --version && cargo outdated --version \
 && tini --version && [ "$(command -v tail)" = /usr/local/bin/tail ]
